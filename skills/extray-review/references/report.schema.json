{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExtRay portable candidate review v1",
  "description": "Generated by npm run skill:sync. Structural validity is not claim verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "methodology",
    "verification",
    "target",
    "evidence_mode",
    "investigation",
    "summary",
    "findings",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "methodology": {
      "const": "extray-review"
    },
    "verification": {
      "const": "not-run"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_mode": {
      "type": "string",
      "enum": [
        "source-only",
        "source-and-pack"
      ]
    },
    "investigation": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "claim_type",
          "severity",
          "category",
          "confidence",
          "finding_type",
          "claimed_mechanism",
          "evidence_refs",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "observed-capability",
              "inferred-behavior"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "permissions",
              "data-exfiltration",
              "code-execution",
              "obfuscation",
              "supply-chain",
              "messaging-surface",
              "remote-resources",
              "claim-mismatch",
              "anomaly",
              "other"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "finding_type": {
            "type": "string",
            "enum": [
              "vulnerability",
              "malicious",
              "unwanted",
              "risky-capability",
              "benign",
              "unknown"
            ]
          },
          "claimed_mechanism": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "location",
                "symbol",
                "sink_or_string"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "line"
                  ],
                  "properties": {
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "column": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "symbol": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "sink_or_string": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                }
              }
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "status",
          "finding_ids",
          "checks_run",
          "note"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "exfiltration",
              "code-execution",
              "stated-purpose-deviation",
              "permission-justification",
              "obfuscation"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "findings",
              "cleared",
              "inconclusive"
            ]
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "checks_run": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
